LLM_MODE=mock

# Se obtiene en: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# 1. Habla con @BotFather en Telegram → /newbot → copia el token aquí.
# 2. Arranca el bot, mándale /start, y tu chat_id aparecerá en los logs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Voz de Durruti — Microsoft Edge TTS (gratuito, sin API key)
# Opciones recomendadas: es-ES-ElviraNeural (F), es-ES-AlvaroNeural (M), es-MX-JorgeNeural (M)
DURRUTI_VOICE_ID=es-ES-AlvaroNeural

DAILY_BUDGET_EUR=5.0
LOG_LEVEL=INFO
