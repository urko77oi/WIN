# ─────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno para Durruti.
#
# Copia este archivo como `.env` (en la raíz del proyecto) y rellena
# los valores que necesites. NUNCA subas el .env a git.
# ─────────────────────────────────────────────────────────────────────

# Modo del cliente LLM:
#   - mock: respuestas simuladas, coste 0, ideal para Fase 0.
#   - real: llamadas reales a la API de Anthropic (necesita ANTHROPIC_API_KEY).
LLM_MODE=mock

# API key de Anthropic (solo necesaria si LLM_MODE=real).
# Se obtiene en: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Telegram (Fase 1 — todavía no se usa).
# Bot creado vía @BotFather. chat_id se obtiene con scripts/setup_telegram.py.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Límites operativos
DAILY_BUDGET_EUR=5.0
LOG_LEVEL=INFO
